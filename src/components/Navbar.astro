---
import {
    IoMenuOutline,
    IoPersonOutline,
    IoCodeSlashOutline,
    IoLayersOutline,
    IoPaperPlaneOutline,
    IoTerminalOutline,
} from "react-icons/io5";
---

<nav
    class="border-b border-neutral-200/50 bg-white/70 backdrop-blur-md p-5 w-full sticky top-0 z-50 transition-all"
>
    <div
        class="flex justify-between sm:justify-evenly items-center max-w-5xl mx-auto"
    >
        <h1
            class="font-family-gabarito text-2xl font-bold flex items-center gap-2 cursor-pointer group"
        >
            <span
                class="text-black group-hover:text-blue-600 group-hover:rotate-12 transition-all duration-300 hidden lg:flex items-center"
            >
                <IoTerminalOutline client:load />
            </span>
            <a href="/" class="text-black transition-colors duration-300"
                >John Doe</a
            >
        </h1>
        <button
            class="p-2 border rounded-lg border-neutral-200 text-xl text-black transition-colors duration-300 ease-in-out hover:bg-blue-600 hover:border-neutral-300 hover:text-white active:scale-95 sm:hidden"
        >
            <IoMenuOutline client:load />
        </button>
        <ul class="hidden sm:flex gap-12 ml-16 font-family-outfit">
            <li
                class="relative group cursor-pointer flex items-center gap-2 py-2 text-black transition-colors duration-300"
            >
                <a href="/whoami" class="flex items-center gap-2">
                    <span
                        class="text-lg group-hover:text-blue-600 group-hover:-translate-y-1 group-hover:scale-110 transition-all duration-300 flex items-center"
                    >
                        <IoPersonOutline client:load />
                    </span>
                    <span class="font-medium text-xs uppercase tracking-widest"
                        >How am I?</span
                    >
                </a>
                <span
                    class="absolute left-0 bottom-0 w-full h-0.5 bg-blue-600 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out origin-center"
                ></span>
            </li>
            <li
                class="relative group cursor-pointer flex items-center gap-2 py-2 text-black transition-colors duration-300"
            >
                <span
                    class="text-lg group-hover:text-blue-600 group-hover:-translate-y-1 group-hover:scale-110 transition-all duration-300 flex items-center"
                >
                    <IoCodeSlashOutline client:load />
                </span>
                <span class="font-medium text-xs uppercase tracking-widest"
                    >My Projects</span
                >
                <span
                    class="absolute left-0 bottom-0 w-full h-0.5 bg-blue-600 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out origin-center"
                ></span>
            </li>
            <li
                class="relative group cursor-pointer flex items-center gap-2 py-2 text-black transition-colors duration-300"
            >
                <span
                    class="text-lg group-hover:text-blue-600 group-hover:-translate-y-1 group-hover:scale-110 transition-all duration-300 flex items-center"
                >
                    <IoLayersOutline client:load />
                </span>
                <span class="font-medium text-xs uppercase tracking-widest"
                    >Skills</span
                >
                <span
                    class="absolute left-0 bottom-0 w-full h-0.5 bg-blue-600 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out origin-center"
                ></span>
            </li>
            <li
                class="relative group cursor-pointer flex items-center gap-2 py-2 text-black transition-colors duration-300"
            >
                <span
                    class="text-lg group-hover:text-blue-600 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:scale-110 transition-all duration-300 flex items-center"
                >
                    <IoPaperPlaneOutline client:load />
                </span>
                <span class="font-medium text-xs uppercase tracking-widest"
                    >Contact me</span
                >
                <span
                    class="absolute left-0 bottom-0 w-full h-0.5 bg-blue-600 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out origin-center"
                ></span>
            </li>
        </ul>
    </div>
</nav>
