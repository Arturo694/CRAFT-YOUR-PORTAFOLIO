---
import MainLayout from "../layouts/MainLayout.astro";
import {
    IoLogoGithub,
    IoGlobeOutline,
    IoCodeSlashOutline,
    IoServerOutline,
    IoColorPaletteOutline,
    IoPhonePortraitOutline,
    IoRocketOutline,
} from "react-icons/io5";
---

<MainLayout>
    <section class="w-full max-w-5xl mx-auto px-6 pt-12 pb-8">
        <p
            class="font-family-outfit text-sm uppercase tracking-widest text-blue-600 font-semibold mb-2 text-center"
        >
            My work
        </p>
        <h2
            class="font-family-gabarito font-bold text-3xl md:text-4xl text-center text-gray-800 mb-10"
        >
            Projects I've built
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            <article
                class="group bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col"
            >
                <span
                    class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-50 text-blue-600 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shrink-0"
                >
                    <IoRocketOutline client:load />
                </span>
                <h3
                    class="font-family-gabarito font-bold text-lg text-gray-800 mb-2"
                >
                    Project One
                </h3>
                <p
                    class="font-family-outfit text-sm text-gray-500 leading-relaxed mb-4 grow"
                >
                    A brief description of what the project does, technologies
                    used, and impact.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >React</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Node.js</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >TypeScript</span>
                </div>
                <div class="flex gap-2">
                    <a
                        href="https://github.com/your-username/project-one"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 transition-colors duration-300"
                    >
                        <IoLogoGithub client:load />
                        Code
                    </a>
                    <a
                        href="https://project-one-demo.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 text-gray-700 text-sm font-medium rounded-xl hover:border-blue-300 hover:text-blue-600 transition-colors duration-300"
                    >
                        <IoGlobeOutline client:load />
                        Demo
                    </a>
                </div>
            </article>

            <article
                class="group bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col"
            >
                <span
                    class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-50 text-blue-600 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shrink-0"
                >
                    <IoCodeSlashOutline client:load />
                </span>
                <h3
                    class="font-family-gabarito font-bold text-lg text-gray-800 mb-2"
                >
                    Project Two
                </h3>
                <p
                    class="font-family-outfit text-sm text-gray-500 leading-relaxed mb-4 grow"
                >
                    An open-source CLI tool to scaffold modern web projects in
                    seconds.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Rust</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >CLI</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Open Source</span>
                </div>
                <div class="flex gap-2">
                    <a
                        href="https://github.com/your-username/project-two"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 transition-colors duration-300"
                    >
                        <IoLogoGithub client:load />
                        Code
                    </a>
                    <a
                        href="https://project-two-demo.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 text-gray-700 text-sm font-medium rounded-xl hover:border-blue-300 hover:text-blue-600 transition-colors duration-300"
                    >
                        <IoGlobeOutline client:load />
                        Demo
                    </a>
                </div>
            </article>

            <article
                class="group bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col"
            >
                <span
                    class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-50 text-blue-600 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shrink-0"
                >
                    <IoServerOutline client:load />
                </span>
                <h3
                    class="font-family-gabarito font-bold text-lg text-gray-800 mb-2"
                >
                    Project Three
                </h3>
                <p
                    class="font-family-outfit text-sm text-gray-500 leading-relaxed mb-4 grow"
                >
                    A real-time dashboard for monitoring server health and
                    application metrics.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Python</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >FastAPI</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Docker</span>
                </div>
                <div class="flex gap-2">
                    <a
                        href="https://github.com/your-username/project-three"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 transition-colors duration-300"
                    >
                        <IoLogoGithub client:load />
                        Code
                    </a>
                    <a
                        href="https://project-three-demo.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 text-gray-700 text-sm font-medium rounded-xl hover:border-blue-300 hover:text-blue-600 transition-colors duration-300"
                    >
                        <IoGlobeOutline client:load />
                        Demo
                    </a>
                </div>
            </article>

            <article
                class="group bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col"
            >
                <span
                    class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-50 text-blue-600 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shrink-0"
                >
                    <IoColorPaletteOutline client:load />
                </span>
                <h3
                    class="font-family-gabarito font-bold text-lg text-gray-800 mb-2"
                >
                    Project Four
                </h3>
                <p
                    class="font-family-outfit text-sm text-gray-500 leading-relaxed mb-4 grow"
                >
                    A design system component library built with accessibility
                    and consistency in mind.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Vue</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Storybook</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >CSS</span>
                </div>
                <div class="flex gap-2">
                    <a
                        href="https://github.com/your-username/project-four"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 transition-colors duration-300"
                    >
                        <IoLogoGithub client:load />
                        Code
                    </a>
                </div>
            </article>

            <article
                class="group bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col"
            >
                <span
                    class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-50 text-blue-600 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shrink-0"
                >
                    <IoPhonePortraitOutline client:load />
                </span>
                <h3
                    class="font-family-gabarito font-bold text-lg text-gray-800 mb-2"
                >
                    Project Five
                </h3>
                <p
                    class="font-family-outfit text-sm text-gray-500 leading-relaxed mb-4 grow"
                >
                    A cross-platform mobile app for tracking daily habits and
                    building better routines.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >React Native</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Expo</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Firebase</span>
                </div>
                <div class="flex gap-2">
                    <a
                        href="https://github.com/your-username/project-five"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 transition-colors duration-300"
                    >
                        <IoLogoGithub client:load />
                        Code
                    </a>
                </div>
            </article>

            <article
                class="group bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col"
            >
                <span
                    class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-50 text-blue-600 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shrink-0"
                >
                    <IoGlobeOutline client:load />
                </span>
                <h3
                    class="font-family-gabarito font-bold text-lg text-gray-800 mb-2"
                >
                    Project Six
                </h3>
                <p
                    class="font-family-outfit text-sm text-gray-500 leading-relaxed mb-4 grow"
                >
                    A landing page template optimized for performance, SEO, and
                    conversion.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Astro</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >Tailwind</span>
                    <span
                        class="font-family-outfit text-xs font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-600"
                    >SEO</span>
                </div>
                <div class="flex gap-2">
                    <a
                        href="https://github.com/your-username/project-six"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 transition-colors duration-300"
                    >
                        <IoLogoGithub client:load />
                        Code
                    </a>
                    <a
                        href="https://project-six-demo.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 text-gray-700 text-sm font-medium rounded-xl hover:border-blue-300 hover:text-blue-600 transition-colors duration-300"
                    >
                        <IoGlobeOutline client:load />
                        Demo
                    </a>
                </div>
            </article>
        </div>
    </section>
</MainLayout>
