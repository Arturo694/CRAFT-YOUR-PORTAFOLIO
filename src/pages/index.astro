---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
	<section class="flex flex-col items-center p-8">
		<div class="mb-14">
			<p
				class="font-family-gabarito font-bold text-4xl md:text-5xl text-center leading-tight"
			>
				Hey!, I am <span
					class="bg-linear-to-r from-blue-600 via-indigo-500 to-purple-500 bg-clip-text text-transparent"
					>John Doe</span
				>,
				<br class="hidden sm:block" />
				Developer and Designer
			</p>
		</div>
		<div
			class="mb-14 p-1 rounded-full bg-linear-to-tr from-blue-500 via-indigo-500 to-purple-500 shadow-2xl shadow-blue-500/25 hover:shadow-blue-500/40 transition-shadow duration-500"
		>
			<img
				src="/random_person.jpg"
				alt="Profile picture"
				class="w-48 h-48 rounded-full object-cover border-4 border-white transform hover:scale-105 transition-transform duration-300"
			/>
		</div>
		<div class="mb-14 max-w-md">
			<p
				class="font-family-outfit font-normal text-lg text-center text-gray-500"
			>
				Passionate about crafting interactive and user-centered digital
				experiences.
			</p>
			<div
				class="mt-4 mx-auto w-16 h-1 rounded-full bg-linear-to-r from-blue-500 to-indigo-500"
			>
			</div>
		</div>
	</section>
</MainLayout>
